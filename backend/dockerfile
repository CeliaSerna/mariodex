# 1. Usamos una imagen de PHP con Apache
FROM php:8.2-apache

# 2. Instalamos dependencias del sistema y extensiones de PHP necesarias
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    libpq-dev \
    zip \
    unzip \
    git \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install gd zip pdo pdo_pgsql bcmath

# 3. Activamos el módulo rewrite de Apache (vital para las rutas de Laravel)
RUN a2enmod rewrite

# 4. Instalamos Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# 5. Copiamos los archivos del proyecto al contenedor
COPY . /var/www/html

# 6. Configuramos el directorio de trabajo y permisos
WORKDIR /var/www/html
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

# 7. Instalamos las dependencias de PHP (sin las de desarrollo)
RUN composer install --no-dev --optimize-autoloader

# 8. Ajustamos el DocumentRoot de Apache para que apunte a /public
ENV APACHE_DOCUMENT_ROOT /var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

# 9. Exponemos el puerto 80 (el que usa Render por defecto)
EXPOSE 80

# 10. Comando para arrancar Apache
CMD ["apache2-foreground"]